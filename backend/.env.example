# Copie para .env e preencha. Nunca faça commit do arquivo .env.

# Connection string do NeonDB (Dashboard > Connect). Prefira a "pooled" (host com -pooler).
DATABASE_URL=postgresql://USUARIO:SENHA@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Porta do servidor local (npm run dev).
PORT=3000

# Opcional: se definida, POST/PUT/PATCH/DELETE exigem o header "x-api-key" com este valor.
API_KEY=

# Origens liberadas no CORS (separadas por vírgula). "*" libera todas.
CORS_ORIGIN=*
