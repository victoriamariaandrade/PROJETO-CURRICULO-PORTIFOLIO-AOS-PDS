meta {
  name: Criar (pessoa de teste)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/people/{{testPersonSlug}}/contacts
  body: json
  auth: inherit
}

body:json {
  {
    "type": "email",
    "label": "teste@example.com",
    "url": "mailto:teste@example.com",
    "displayOrder": 1
  }
}

script:post-response {
  if (res.getBody()?.data?.id) bru.setVar("contactId", res.getBody().data.id);
}

tests {
  test("Status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("Resposta tem \"data\"", function () {
    expect(res.getBody()).to.have.property('data');
  });
}
