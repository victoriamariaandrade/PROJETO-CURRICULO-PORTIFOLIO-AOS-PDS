meta {
  name: Criar (pessoa de teste)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/people/{{testPersonSlug}}/projects
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Projeto Teste",
    "description": "Criado pelo Bruno.",
    "category": "Mobile",
    "partner": "Projeto acadêmico",
    "icon": "rocket-outline",
    "repositoryUrl": "https://github.com/teste/projeto",
    "technologies": [
      "React Native",
      "Expo"
    ],
    "displayOrder": 1
  }
}

script:post-response {
  if (res.getBody()?.data?.id) bru.setVar("projectId", res.getBody().data.id);
}

tests {
  test("Status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("Resposta tem \"data\"", function () {
    expect(res.getBody()).to.have.property('data');
  });
}
