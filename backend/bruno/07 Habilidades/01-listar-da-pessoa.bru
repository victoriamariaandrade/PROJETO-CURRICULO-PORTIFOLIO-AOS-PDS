meta {
  name: Listar da pessoa
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/people/{{personRef}}/skill-categories
  body: none
  auth: inherit
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Resposta tem \"data\"", function () {
    expect(res.getBody()).to.have.property('data');
  });

  test("Lista", function () {
    expect(res.getBody().data).to.be.an('array');
  });
}
