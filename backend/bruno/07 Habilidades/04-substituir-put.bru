meta {
  name: Substituir (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/skill-categories/{{skillCategoryId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Mobile",
    "icon": "phone-portrait-outline",
    "skills": [
      "React Native",
      "Expo",
      "Kotlin"
    ],
    "displayOrder": 1
  }
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Resposta tem \"data\"", function () {
    expect(res.getBody()).to.have.property('data');
  });
}
