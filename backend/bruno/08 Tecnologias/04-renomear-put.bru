meta {
  name: Renomear (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/technologies/{{technologyId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Tecnologia Bruno 2"
  }
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Resposta tem \"data\"", function () {
    expect(res.getBody()).to.have.property('data');
  });
}
