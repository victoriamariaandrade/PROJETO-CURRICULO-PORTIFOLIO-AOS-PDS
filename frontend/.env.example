# Copie para .env.local e ajuste. Reinicie o bundler (npx expo start --clear) após mudar.

# Fonte de dados: "api" (padrão, consome o backend) ou "static" (dados locais, sem rede).
EXPO_PUBLIC_DATA_SOURCE=api

# URL da API, sem barra final. Em produção, o endereço da Vercel.
# No celular/emulador, "localhost" não aponta para o seu computador: use o IP da rede local
# (ex.: http://192.168.0.10:3000) ou a URL da Vercel.
EXPO_PUBLIC_API_URL=https://SEU-PROJETO.vercel.app

# Pessoa exibida no app: slug ou ID cadastrado no banco.
EXPO_PUBLIC_PERSON=victoria-andrade
